{
  "name": "openvisio-windows",
  "version": "41.77.0",
  "private": true,
  "type": "module",
  "description": "OpenVisio Windows : édition de diagrammes, analyse et recommandations SAN déterministes",
  "author": "Abdelhalim Talbi",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8080",
    "benchmark": "node tests/run-benchmark.mjs",
    "benchmark:svg": "node tests/svg-dom-benchmark.mjs",
    "benchmark:large": "node tests/benchmark-large.mjs",
    "benchmark:spatial": "node tests/benchmark-v175.mjs",
    "test:browser": "python3 tests/browser-recovery.py",
    "benchmark:routing": "node tests/benchmark-v222.mjs",
    "benchmark:dense": "node tests/benchmark-v228.mjs",
    "benchmark:differential": "node tests/benchmark-v239.mjs",
    "benchmark:dom": "node tests/benchmark-v240.mjs",
    "benchmark:browser-san": "python tests/browser-san-performance.py --report BENCHMARK-BROWSER-V24.8.json",
    "test:browser-san-e2e": "python3 tests/browser-san-e2e-v263.py --report qualification-windows/san-e2e-v263.json --screenshot qualification-windows/san-e2e-v263-real.png",
    "benchmark:san": "node tests/benchmark-san-v265.mjs",
    "benchmark:routing-comparison": "node tests/benchmark-routing-v267.mjs",
    "benchmark:cache-comparison": "node tests/benchmark-cache-comparison-v418.mjs",
    "benchmark:svg:bounded": "node scripts/benchmark-svg-v426.mjs",
    "benchmark:svg:profile": "node scripts/benchmark-svg-v427.mjs",
    "benchmark:svg:phases": "node scripts/benchmark-svg-v429.mjs"
  }
}
